---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Interfluent",
  description = "Shared context for business, product and engineering.",
  canonical = Astro.url.pathname,
  active = "",
  robots = "index,follow",
  image = "/assets/images/webclip.png",
} = Astro.props;

const site = "https://interfluent.ai";
const canonicalUrl = new URL(canonical, site);
const imageUrl = new URL(image, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Interfluent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href="/assets/images/favicon-light.png" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href="/assets/images/favicon-dark.png" />
    <link rel="apple-touch-icon" href="/assets/images/webclip.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/assets/css/global.css" />
    <link rel="stylesheet" href="/assets/css/components.css" />
    <link rel="stylesheet" href="/assets/css/pages/site-nav.css" />
    <link rel="stylesheet" href="/assets/css/pages/site-footer.css" />
    <link rel="stylesheet" href="/assets/css/responsive.css" />
    <slot name="head" />
  </head>
  <body>
    <div class="page-wrapper">
      <Navbar active={active} />
      <main class="main-wrapper">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
