---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---
<BaseLayout title="Request Beta Access | Interfluent" description="Request private beta access to Interfluent." canonical="/beta/">
<Fragment slot="head"><link rel="stylesheet" href="/assets/css/pages/beta.css" /></Fragment>
{siteConfig.betaEnabled?<section class="beta_beta_section is-first-section"><div><div class="beta_beta_div">PRIVATE BETA</div><h1 class="beta_beta_h1">Put your own codebase on the map.</h1><p class="beta_beta_p">We're onboarding a small number of teams while the agents are still being shaped.</p><div class="beta_beta_div-2"><div class="beta_beta_div-3"><span class="beta_beta_span">01</span><span>Connect one repository and one document set.</span></div><div class="beta_beta_div-4"><span class="beta_beta_span-2">02</span><span>Get a feature map, impact analysis and docs diff.</span></div><div class="beta_beta_div-5"><span class="beta_beta_span-3">03</span><span>Free for the length of the beta.</span></div></div></div><div class="beta_beta_div-6"><form data-beta class="beta_beta_form"><div class="beta_beta_div-7"><label class="beta_beta_label"><span>Name</span><input name="name" required class="beta_beta_input" /></label><label class="beta_beta_label-2"><span>Work email</span><input name="email" type="email" required class="beta_beta_input-2" /></label></div><label class="beta_beta_label-3"><span>Company</span><input name="company" required class="beta_beta_input-3" /></label><label class="beta_beta_label-5"><span>What are you trying to ship?</span><textarea name="message" rows="4" class="beta_beta_textarea"></textarea></label><button class="beta_beta_button">Request beta access</button></form><div data-beta-success class="beta_beta_div-10" hidden><div class="beta_beta_div-11">✓</div><div class="beta_beta_div-12">Request received.</div><div class="beta_beta_div-13">Thanks. We read every request by hand and reply within a few days.</div></div></div></section>:<section class="beta_beta-closed_section is-first-section"><h1 class="beta_beta-closed_h1">The beta is closed for now.</h1><a href="/contact/" class="beta_beta-closed_a">Book a walkthrough</a></section>}
<script is:inline>document.querySelector("[data-beta]")?.addEventListener("submit",e=>{e.preventDefault();e.currentTarget.hidden=true;document.querySelector("[data-beta-success]").hidden=false});</script>
</BaseLayout>
