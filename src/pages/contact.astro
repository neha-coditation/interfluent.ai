---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact | Interfluent" description="Book an Interfluent walkthrough on your own codebase and see how shared context improves impact analysis, planning and delivery." canonical="/contact/" active="contact">
<Fragment slot="head"><link rel="stylesheet" href="/assets/css/pages/contact.css" /></Fragment>
<section class="contact_contact_section is-first-section"><div><div class="contact_contact_div">CONTACT</div><h1 class="contact_contact_h1">Book a walkthrough on your own codebase.</h1><p class="contact_contact_p">Forty-five minutes, live, from feature map to test plan. Bring the change you can't price and we'll price it in front of you.</p><div class="contact_contact_div-2"><div><div class="contact_contact_div-3">EMAIL</div><a href="mailto:hello@codelens.ai" class="contact_contact_a">hello@codelens.ai</a></div><div><div class="contact_contact_div-4">RESPONSE TIME</div>Within two working days</div></div></div><div class="contact_contact_div-5"><form class="contact_contact_form" data-contact-form><div class="contact_contact_div-6"><label class="contact_contact_label"><span>Name</span><input required placeholder="Asha Rao" class="contact_contact_input" /></label><label class="contact_contact_label-2"><span>Work email</span><input type="email" required placeholder="asha@company.com" class="contact_contact_input-2" /></label></div><label class="contact_contact_label-3"><span>I want to</span><select class="contact_contact_select"><option>Book a walkthrough</option><option>Ask about pricing</option><option>Talk about a role</option><option>Something else</option></select></label><label class="contact_contact_label-4"><span>Message</span><textarea rows="5" placeholder="Tell us about the system and the change you have in mind." class="contact_contact_textarea"></textarea></label><button type="submit" class="contact_contact_button">Send</button></form><div class="contact_contact_div-7" data-contact-success hidden><div class="contact_contact_div-8">✓</div><div class="contact_contact_div-9">Sent.</div><div class="contact_contact_div-10">A person will reply within two working days.</div></div></div></section>
<script is:inline>document.querySelector("[data-contact-form]")?.addEventListener("submit",(e)=>{e.preventDefault();e.currentTarget.hidden=true;document.querySelector("[data-contact-success]").hidden=false;});</script>
</BaseLayout>
