---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---
<BaseLayout title="Sign in | Interfluent" description="Sign in to Interfluent." canonical="/signin/" robots="noindex,nofollow">
<Fragment slot="head"><link rel="stylesheet" href="/assets/css/pages/signin.css" /></Fragment>
<section class="signin_sign-in_section is-first-section"><div class="signin_sign-in_div">{siteConfig.accessCodeEnabled?<><div data-locked class="signin_sign-in_div-11"><div class="signin_sign-in_div-5">ACCESS CODE</div><h1 class="signin_sign-in_h1">Enter your code to open Interfluent.</h1><p class="signin_sign-in_p">Codes are issued to beta teams and referred guests.</p><form data-form class="signin_sign-in_form"><input data-input placeholder="XXXX-XXXX" autofocus spellcheck="false" /><div data-error class="signin_sign-in_div-6" hidden></div><button class="signin_sign-in_button">Continue</button></form>{siteConfig.betaEnabled&&<div class="signin_sign-in_div-7">No code yet? <a href="/beta/" class="signin_sign-in_a">Request beta access</a></div>}</div><div data-open class="signin_sign-in_div-8" hidden><div class="signin_sign-in_div-9">✓</div><h1 class="signin_sign-in_h1-2">You're in.</h1><p class="signin_sign-in_p-2">Code <span data-accepted></span> accepted.</p><a href={siteConfig.appUrl} class="signin_sign-in_a-2">Open Interfluent →</a></div></>:<div class="signin_sign-in_div-11"><h1 class="signin_sign-in_h1-3">Sign-in is invite only.</h1><a href="/contact/" class="signin_sign-in_a-4">Contact us</a></div>}</div></section>
<script is:inline>const f=document.querySelector("[data-form]"),i=document.querySelector("[data-input]"),e=document.querySelector("[data-error]"),l=document.querySelector("[data-locked]"),o=document.querySelector("[data-open]");f?.addEventListener("submit",x=>{x.preventDefault();const v=i.value.trim().toUpperCase().replace(/\s+/g,"");if(/^[A-Z0-9]{4}-?[A-Z0-9]{4}$/.test(v)){document.querySelector("[data-accepted]").textContent=v.length===8?v.slice(0,4)+"-"+v.slice(4):v;l.hidden=true;o.hidden=false;e.hidden=true}else{e.textContent=v?"That code isn't recognised.":"Enter your access code.";e.hidden=false}});</script>
</BaseLayout>
