---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
const plans=[
 {k:"PILOT",n:"Pilot",d:"One system, one team, the full loop on your own code.",price:siteConfig.betaEnabled?"Free":"Talk to us",unit:siteConfig.betaEnabled?"during beta":"",f:["1 repository, 1 document set","Feature map, context graph, impact analysis","PRD, Brief and Docs agents","Shared Slack channel with our team"],cta:siteConfig.betaEnabled?"Request beta access":"Book a walkthrough",href:siteConfig.betaEnabled?"/beta/":"/contact/",featured:false},
 {k:"TEAM",n:"Team",d:"For a product organisation that ships every week and wants the record to stay true.",price:"Per system",unit:"billed annually",f:["Unlimited repositories per system","Unlimited readers across business, product and engineering","Debt, security and coverage by capability","Test plans and the governing loop","SSO and audit log"],cta:"Talk to us",href:"/contact/",featured:true},
 {k:"ENTERPRISE",n:"Enterprise",d:"Several systems, your cloud, your controls.",price:"Custom",unit:"",f:["Runs in your VPC","Cross-system feature map","Custom agents via Agent Builder","Dedicated customer engineer"],cta:"Talk to us",href:"/contact/",featured:false}
];
---
<BaseLayout title="Pricing | Interfluent" description="Explore Interfluent pricing for teams that need shared product and engineering context." canonical="/pricing/" active="pricing">
<Fragment slot="head"><link rel="stylesheet" href="/assets/css/pages/pricing.css" /></Fragment>
<section class="pricing_pricing-intro_section is-first-section"><div class="pricing_pricing-intro_div">PRICING</div><h1 class="pricing_pricing-intro_h1">Priced per system, not per seat.</h1><p class="pricing_pricing-intro_p">Business, product and engineering all need to read the same map. Charging per reader would defeat the point.</p></section>
<section class="pricing_pricing-plans_section"><div class="pricing_pricing-plans_div">{plans.map(p=><div class:list={["pricing-card",p.featured&&"is-featured"]}><div class="pricing_pricing-plans_div-2"><span class="pricing_pricing-plans_span">{p.k}</span></div><div><div class="pricing_pricing-plans_div-3">{p.n}</div><div class="pricing_pricing-plans_div-4">{p.d}</div></div><div class="pricing_pricing-plans_div-5">{p.price}<span class="pricing_pricing-plans_span-3">{p.unit}</span></div><div class="pricing-features">{p.f.map(x=><div class="pricing_pricing-plans_div-6"><span class="pricing_pricing-plans_span-4"></span><span>{x}</span></div>)}</div><a href={p.href} class="pricing-cta">{p.cta}</a></div>)}</div></section>
</BaseLayout>
<style>.pricing-card{border-radius:20px;padding:32px 28px;background:var(--color-surface);color:var(--color-text);border:1px solid rgba(30,28,25,.1);display:flex;flex-direction:column;gap:18px}.pricing-card.is-featured{background:var(--color-primary);color:var(--color-bg);box-shadow:0 24px 60px rgba(31,78,61,.25)}.pricing-features{display:flex;flex-direction:column;gap:10px;font-size:14.5px;line-height:1.45;padding-top:6px}.pricing-cta{margin-top:auto;text-align:center;padding:13px 20px;border-radius:999px;font-weight:600;font-size:15px;border:1px solid rgba(30,28,25,.18)}.is-featured .pricing-cta{background:var(--color-accent);color:var(--color-text);border-color:var(--color-accent)}</style>
