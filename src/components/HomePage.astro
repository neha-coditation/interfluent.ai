<script is:inline>
(() => {
  const c=(x)=>Math.max(0,Math.min(1,x)), seg=(p,a,b)=>c((p-a)/(b-a)), ease=(t)=>t*t*(3-2*t);
  const flow=(el,span=.9)=>{if(!el)return 0;const r=el.getBoundingClientRect();return c((innerHeight*.88-r.top)/(innerHeight*span));};
  const pin=(el)=>{if(!el)return 0;const r=el.getBoundingClientRect();return c(-r.top/Math.max(1,r.height-innerHeight));};
  const sections=[...document.querySelectorAll("[data-screen-label]")];
  const by=(label)=>sections.find(x=>x.dataset.screenLabel===label);
  let raf=0;
  function set(){
    raf=0;
    const today=by("Act 1 · Today"), p1=flow(today,1.3);
    const cards=[...today?.querySelectorAll(":scope > div:nth-of-type(2) > div")||[]];
    if(cards[0])cards[0].style.transform=`translate(${(1-ease(seg(p1,.05,.42)))*-42}px,${(1-ease(seg(p1,.05,.42)))*24}px) rotate(-1.5deg)`;
    if(cards[1])cards[1].style.transform=`translateY(${(1-ease(seg(p1,.12,.5)))*34}px)`;
    if(cards[2])cards[2].style.transform=`translate(${(1-ease(seg(p1,.18,.56)))*42}px,${(1-ease(seg(p1,.18,.56)))*24}px) rotate(1.5deg)`;

    const context=by("Act 2 · Shared context"), p2=pin(context);
    const paras=[...context?.querySelectorAll(".rs-pin2-copy > p")||[]], bars=[...context?.querySelectorAll(":scope span > span")||[]].slice(0,3);
    const vals=[1-seg(p2,.30,.40),seg(p2,.36,.46)*(1-seg(p2,.66,.76)),seg(p2,.72,.82)];
    paras.forEach((el,i)=>{el.style.opacity=String(vals[i]||0)});
    [seg(p2,0,.36),seg(p2,.36,.72),seg(p2,.72,1)].forEach((x,i)=>{if(bars[i])bars[i].style.transform=`scaleX(${x})`});

    const app=by("Act 3 · Interfluent"), p3=flow(app,1.1), aw=app?.querySelector(":scope > div:nth-of-type(2)"), av=ease(seg(p3,0,.35));
    if(aw){aw.style.opacity=String(av);aw.style.transform=`translateY(${(1-av)*40}px) scale(${.97+.03*av})`;}

    const imp=by("Act 3 · Impact"), p4=flow(imp,.7), ic=imp?.querySelector(":scope > div:nth-of-type(2)"), iv=ease(seg(p4,0,.2));
    if(ic){ic.style.opacity=String(iv);ic.style.transform=`translateY(${(1-iv)*30}px)`;}
    const it=imp?.querySelector(":scope > div:nth-of-type(2) > div:nth-of-type(2)");
    if(it){const s="Retire the legacy DXF parser and route all imports through DrawingConversionService.";it.childNodes[0].textContent=s.slice(0,Math.round(ease(seg(p4,.05,.5))*s.length));}

    const stagger=(label,selector,span,start,step,end,y=24)=>{
      const el=by(label),p=flow(el,span);[...el?.querySelectorAll(selector)||[]].forEach((x,i)=>{const t=ease(seg(p,start+i*step,end+i*step));x.style.opacity=String(t);x.style.transform=`translateY(${(1-t)*y}px)`;});
    };
    stagger("Act 3 · Agents",":scope > div:nth-of-type(2) > div",.6,.1,.1,.4);
    stagger("Audiences",":scope > div > div:nth-of-type(2) > div",.6,.1,.12,.4);
    stagger("Where it sits",":scope > div:nth-of-type(2) > div",.7,.05,.12,.35,20);
    stagger("Differentiation",".rs-diff:not(.rs-diffhead)",.7,.05,.1,.35,14);
  }
  const run=()=>{if(!raf)raf=requestAnimationFrame(set)};
  addEventListener("scroll",run,{passive:true});addEventListener("resize",run);run();
})();
</script>
